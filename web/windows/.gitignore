flutter/ephemeral/
*.suo
*.user
*.userosscache
*.sln.docstates
x64/
x86/
*.[Cc]ache
!*.[Cc]ache/

# Mac specific
.DS_Store

# Dart Analysis Server (Dart Language Server)
.analysis_options