# Build output
/build/

# IDE/Dart tool files
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.vs/
.vscode/

# Dependency cache and downloaded packages
/ios/.symlinks/
/ios/.generated/
/android/.gradle
/android/local.properties
/android/.idea
/android/captures
/android/app/build
/android/app/.cxx
/android/app/.externalNativeBuild

